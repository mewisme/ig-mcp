# Optional template: copy to .env.local in the directory where you run ig-mcp.
# .env.local is auto-loaded; only set values you use. Never commit real credentials.
# Used by: ig-mcp serve (default: --transport openai)
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=

# Android/web login only; unset or empty values are prompted for in the CLI.
# Keep passwords, cookies and keys local; avoid pasting them into logs.
IG_MCP_LOGIN_IDENTITY=
IG_MCP_LOGIN_PASSWORD=

# Authenticator-app TOTP secret (base32 key or standard otpauth:// URI).
# The current 6-digit 2FA code is generated on demand.
# Not interchangeable with a temporary 6-digit code, SMS, or recovery token.
IG_MCP_LOGIN_TOTP_SECRET=

# Optional browser Cookie header or JSON object, for login --method cookie.
# Example format: 'sessionid=...; csrftoken=...; ds_user_id=...'
IG_MCP_LOGIN_COOKIES=

# Optional override: absolute path to a private Instagram session file.
# Default is the user's OS configuration directory: ig-mcp/session.json.
# IG_MCP_SESSION_FILE=/absolute/path/to/session.json

# Optional MCP operation safeguards (evaluated server-side).
# IG_MCP_READ_ONLY=true
# IG_MCP_DENY_TOOLS=ig_delete_thread,ig_block_user
# IG_MCP_WRITE_RATE_LIMIT_PER_MINUTE=60
# IG_MCP_REQUIRE_DESTRUCTIVE_APPROVAL=true
# Note: destructive approval guard blocks these operations until the operator
# explicitly reconfigures it; no interactive remote approval provider is built in.